{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aicnc:historical-reference-index:0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "production_enabled", "applicability", "catalog_sha256", "merge_plan_sha256", "case_count", "record_count", "families", "conflicts", "gaps"],
  "properties": {
    "schema_version": {"const": "aicnc.historical-reference-index/0.1"},
    "production_enabled": {"const": false},
    "applicability": {"const": "must_compare_conditions"},
    "catalog_sha256": {"$ref": "#/$defs/hash"}, "merge_plan_sha256": {"$ref": "#/$defs/hash"},
    "case_count": {"type": "integer", "minimum": 0}, "record_count": {"type": "integer", "minimum": 0},
    "families": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "title", "summary", "distinct_geometry_count", "source_case_count", "variants", "status", "production_enabled"],
      "properties": {
        "id": {"$ref": "#/$defs/text"}, "title": {"$ref": "#/$defs/text"}, "summary": {"$ref": "#/$defs/text"},
        "distinct_geometry_count": {"type": "integer", "minimum": 1}, "source_case_count": {"type": "integer", "minimum": 1},
        "variants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variant"}},
        "status": {"const": "reference_candidate"}, "production_enabled": {"const": false}
      }
    }},
    "conflicts": {"type": "array", "items": {"$ref": "#/$defs/variant"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/variant"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1},
    "variant": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "part_name", "source_step_sha256", "source_mcam_sha256", "library", "library_sha256", "record"],
      "properties": {
        "case_id": {"$ref": "#/$defs/text"}, "part_name": {"$ref": "#/$defs/text"},
        "source_step_sha256": {"$ref": "#/$defs/hash"}, "source_mcam_sha256": {"$ref": "#/$defs/hash"},
        "library": {"$ref": "#/$defs/text"}, "library_sha256": {"$ref": "#/$defs/hash"},
        "record": {"$ref": "aicnc:historical-process-reference:0.1#/properties/templates/items"}
      }
    }
  }
}
