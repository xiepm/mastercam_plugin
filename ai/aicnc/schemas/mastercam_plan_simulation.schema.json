                "diameter_mm",
                "length_mm",
                "flute_length_mm",
                "shoulder_length_mm",
                "holder_diameter_mm",
                "holder_length_mm",
                "length_offset",
                "diameter_offset"
              ],
              "properties": {
                "type": {
                  "type": "string"
                },
                "metric": {
                  "type": "boolean"
                },
                "number": {
                  "type": "number"
                },
                "diameter_mm": {
                  "type": "number"
                },
                "length_mm": {
                  "type": "number"
                },
                "flute_length_mm": {
                  "type": "number"
                },
                "shoulder_length_mm": {
                  "type": "number"
                },
                "holder_diameter_mm": {
                  "type": "number"
                },
                "holder_length_mm": {
                  "type": "number"
                },
                "length_offset": {
                  "type": "number"
                },
                "diameter_offset": {
                  "type": "number"
