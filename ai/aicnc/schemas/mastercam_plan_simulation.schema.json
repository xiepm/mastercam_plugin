{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-cnc.local/schemas/mastercam_plan_simulation.schema.json",
  "title": "Bounded Mastercam plan simulation",
  "oneOf": [
    {
      "$ref": "#/$defs/binding"
    },
    {
      "$ref": "#/$defs/verification"
    },
    {
      "$ref": "#/$defs/native_request"
    },
    {
      "$ref": "#/$defs/native_receipt"
    },
    {
      "$ref": "#/$defs/simulator_receipt"
    }
  ],
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "scope",
        "profile",
        "plan",
        "setup_id",
        "operation_id",
        "feature_instance_ids",
        "face_ids",
        "geometry",
        "tool_assembly",
        "target"
      ],
      "properties": {
        "schema_version": {
          "const": "aicnc.mastercam-plan-simulation-binding/0.1"
        },
        "scope": {
          "const": "synthetic_native_validation"
        },
        "profile": {
          "const": "rectangular_external_contour"
        },
        "plan": {
          "$ref": "#/$defs/asset"
        },
        "setup_id": {
          "type": "string",
          "minLength": 1
        },
        "operation_id": {
          "type": "string",
          "minLength": 1
        },
        "feature_instance_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "face_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width_mm",
            "height_mm",
            "depth_mm",
            "margin_mm",
            "stock_height_mm"
          ],
          "properties": {
            "width_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "height_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "depth_mm": {
              "type": "number",
              "exclusiveMaximum": 0
            },
            "margin_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stock_height_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "tool_assembly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "length_mm",
            "flute_length_mm",
            "shoulder_length_mm",
            "holder_diameter_mm",
            "holder_length_mm"
          ],
          "properties": {
            "length_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "flute_length_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "shoulder_length_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "holder_diameter_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "holder_length_mm": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "target": {
          "$ref": "#/$defs/asset"
        }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "triangles",
        "volume_mm3",
        "min",
        "max",
        "geometry_sha256",
        "sha256"
      ],
      "properties": {
        "triangles": {
          "type": "integer",
          "minimum": 1
        },
        "volume_mm3": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "max": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "geometry_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "passed",
        "errors",
        "model_path",
        "model_sha256",
        "plan_sha256",
        "fresh_pids",
        "meshes",
        "scope",
        "production_released",
        "postprocessing_performed",
        "machine_simulation_verified"
      ],
      "properties": {
        "schema_version": {
          "const": "aicnc.mastercam-plan-simulation-verification/0.1"
        },
        "passed": {
          "type": "boolean"
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "model_path": {
          "type": "string",
          "minLength": 1
        },
        "model_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "plan_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "fresh_pids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "meshes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/mesh"
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "production_released": {
          "const": false
        },
        "postprocessing_performed": {
          "const": false
        },
        "machine_simulation_verified": {
          "const": false
        }
      }
    },
    "native_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width_mm",
        "height_mm",
        "depth_mm",
        "margin_mm",
        "stock_height_mm",
        "tool_diameter_mm",
        "feed_mm_min",
        "spindle_rpm",
        "tool_length_mm",
        "flute_length_mm",
        "shoulder_length_mm",
        "holder_diameter_mm",
        "holder_length_mm",
        "plan_path",
        "plan_sha256",
        "binding_path",
        "binding_sha256",
        "target_path",
        "target_sha256",
        "step_path",
        "step_sha256",
        "schema_version",
        "purpose",
        "run_id",
        "model_path",
        "operation_name"
      ],
      "properties": {
        "width_mm": {
          "type": "number"
        },
        "height_mm": {
          "type": "number"
        },
        "depth_mm": {
          "type": "number"
        },
        "margin_mm": {
          "type": "number"
        },
        "stock_height_mm": {
          "type": "number"
        },
        "tool_diameter_mm": {
          "type": "number"
        },
        "feed_mm_min": {
          "type": "number"
        },
        "spindle_rpm": {
          "type": "number"
        },
        "tool_length_mm": {
          "type": "number"
        },
        "flute_length_mm": {
          "type": "number"
        },
        "shoulder_length_mm": {
          "type": "number"
        },
        "holder_diameter_mm": {
          "type": "number"
        },
        "holder_length_mm": {
          "type": "number"
        },
        "plan_path": {
          "type": "string"
        },
        "plan_sha256": {
          "type": "string"
        },
        "binding_path": {
          "type": "string"
        },
        "binding_sha256": {
          "type": "string"
        },
        "target_path": {
          "type": "string"
        },
        "target_sha256": {
          "type": "string"
        },
        "step_path": {
          "type": "string"
        },
        "step_sha256": {
          "type": "string"
        },
        "schema_version": {
          "const": "aicnc.mastercam-plan-native-request/0.1"
        },
        "purpose": {
          "const": "synthetic_native_validation"
        },
        "run_id": {
          "type": "string"
        },
        "model_path": {
          "type": "string"
        },
        "operation_name": {
          "type": "string"
        }
      }
    },
    "native_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "ok",
        "pid",
        "utc",
        "production_released",
        "regeneration_performed",
        "stage"
      ],
      "properties": {
        "schema_version": {
          "const": "aicnc.mastercam-plan-native-receipt/0.1"
        },
        "mode": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "pid": {
          "type": "number"
        },
        "utc": {
          "type": "string"
        },
        "production_released": {
          "type": "boolean"
        },
        "regeneration_performed": {
          "type": "boolean"
        },
        "request_sha256": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "api_version": {
          "type": "string"
        },
        "api_sha256": {
          "type": "string"
        },
        "host_version": {
          "type": "string"
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "stock",
            "metric",
            "geometry_count",
            "operation_count",
            "operation_id",
            "operation_type",
            "operation_name",
            "dirty",
            "machine_name",
            "feed_mm_min",
            "spindle_rpm",
            "plunge_mm_min",
            "retract_mm_min",
            "depth_mm",
            "top_stock_mm",
            "clearance_mm",
            "retract_mm",
            "feed_plane_mm",
            "depth_incremental",
            "comp_type",
            "comp_direction",
            "lead_enabled",
            "tool",
            "chain",
            "path"
          ],
          "properties": {
            "stock": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "StockOriginLocation",
                "CylinderAnchor",
                "SolidOrMeshEntID",
                "StockArcs",
                "StockLines",
                "StockColor",
                "LineStyle",
                "StlFilename",
                "CylinderHeight",
                "CylinderDiameter",
                "CenterOnAxis",
                "CylinderAxis",
                "SolidStock",
                "DisplayStock",
                "StockOrigin",
                "StockSize",
                "FitScreenToStock",
                "StockShape",
                "StockPlaneID",
                "StockPlaneName"
              ],
              "properties": {
                "StockOriginLocation": {
                  "type": "number"
                },
                "CylinderAnchor": {
                  "type": "number"
                },
                "SolidOrMeshEntID": {
                  "type": "number"
                },
                "StockArcs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "CenterPoint",
                      "EndAngleDegrees",
                      "StartAngleDegrees",
                      "Radius"
                    ],
                    "properties": {
                      "CenterPoint": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        }
                      },
                      "EndAngleDegrees": {
                        "type": "number"
                      },
                      "StartAngleDegrees": {
                        "type": "number"
                      },
                      "Radius": {
                        "type": "number"
                      }
                    }
                  }
                },
                "StockLines": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "Point1",
                      "Point2"
                    ],
                    "properties": {
                      "Point1": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        }
                      },
                      "Point2": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          },
                          "z": {
                            "type": "number"
                          }
                        }
                      }
                    }
                  }
                },
                "StockColor": {
                  "type": "number"
                },
                "LineStyle": {
                  "type": "number"
                },
                "StlFilename": {
                  "type": "string"
                },
                "CylinderHeight": {
                  "type": "number"
                },
                "CylinderDiameter": {
                  "type": "number"
                },
                "CenterOnAxis": {
                  "type": "boolean"
                },
                "CylinderAxis": {
                  "type": "number"
                },
                "SolidStock": {
                  "type": "boolean"
                },
                "DisplayStock": {
                  "type": "boolean"
                },
                "StockOrigin": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "StockSize": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "x",
                    "y",
                    "z"
                  ],
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "z": {
                      "type": "number"
                    }
                  }
                },
                "FitScreenToStock": {
                  "type": "boolean"
                },
                "StockShape": {
                  "type": "number"
                },
                "StockPlaneID": {
                  "type": "number"
                },
                "StockPlaneName": {
                  "type": "string"
                }
              }
            },
            "metric": {
              "type": "boolean"
            },
            "geometry_count": {
              "type": "number"
            },
            "operation_count": {
              "type": "number"
            },
            "operation_id": {
              "type": "number"
            },
            "operation_type": {
              "type": "string"
            },
            "operation_name": {
              "type": "string"
            },
            "dirty": {
              "type": "boolean"
            },
            "machine_name": {
              "type": "string"
            },
            "feed_mm_min": {
              "type": "number"
            },
            "spindle_rpm": {
              "type": "number"
            },
            "plunge_mm_min": {
              "type": "number"
            },
            "retract_mm_min": {
              "type": "number"
            },
            "depth_mm": {
              "type": "number"
            },
            "top_stock_mm": {
              "type": "number"
            },
            "clearance_mm": {
              "type": "number"
            },
            "retract_mm": {
              "type": "number"
            },
            "feed_plane_mm": {
              "type": "number"
            },
            "depth_incremental": {
              "type": "boolean"
            },
            "comp_type": {
