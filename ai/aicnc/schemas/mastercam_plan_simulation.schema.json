    "simulator_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "ok",
        "action",
        "pid",
        "domain",
        "utc",
        "production_released"
      ],
      "properties": {
        "schema_version": {
          "const": "aicnc.mastercam-simulator-receipt/0.1"
        },
        "ok": {
          "type": "boolean"
        },
        "action": {
          "enum": [
            "configure",
            "run",
            "close",
            "inspect",
            "export",
            "ready",
            "ready-fine",
            "quality",
            "diagnostic-settings"
          ]
        },
        "pid": {
          "type": "integer",
          "minimum": 1
        },
        "domain": {
