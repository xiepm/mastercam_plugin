      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "schema_version",
              "mode",
              "ok",
              "pid",
              "utc",
              "production_released",
              "regeneration_performed",
              "request_sha256",
              "run_id",
              "api_version",
              "api_sha256",
              "host_version",
              "snapshot",
              "model_path",
              "machine_sha256",
              "model_sha256",
              "model_size_bytes",
              "current_file",
              "stage"
            ]
          }
        }
      ]
