              "required": [
                "data_valid",
                "travel_valid",
                "world_min",
                "world_max",
                "wcs_id",
                "tool_plane_id",
                "z_min_mm",
                "z_max_mm",
                "cycle_time_seconds"
              ],
              "properties": {
                "data_valid": {
                  "type": "boolean"
                },
                "travel_valid": {
                  "type": "boolean"
                },
                "world_min": {
                  "type": "array",
