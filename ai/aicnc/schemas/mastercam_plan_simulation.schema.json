        "configured_holder": {
          "type": "object"
        },
        "configured_shaft": {
          "type": "object"
        },
        "configured_arbor": {
          "type": "object"
        },
        "request_accepted": {
          "type": "boolean"
        },
        "motion": {
          "type": "object"
        },
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "target_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "checks": {
          "type": "object"
        },
        "verifiers": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "report_groups": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "precision_mm": {
          "type": "number"
        },
        "requested_precision_mm": {
          "type": "number"
        },
        "precision_factor": {
