{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://aicnc.local/schemas/mastercam_configuration_audit.schema.json",
  "title":"Evidence-scoped Mastercam configuration audit (not a CAM plan)",
  "type":"object",
  "required":["schema_version","profile","production_released","rule_count","operation_count","check_count","summary","validation_layers","operations","parameters","checks"],
  "properties":{
    "schema_version":{"const":"aicnc.mastercam.configuration-audit/0.1"},
    "profile":{"type":"string"},
    "production_released":{"const":false},
    "rule_count":{"type":"integer","minimum":1},
    "operation_count":{"type":"integer","minimum":1},
    "check_count":{"type":"integer","minimum":1},
    "model_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "requested_clearance_mm":{"type":"number","exclusiveMinimum":0},
    "request_scope":{"type":"string"},
    "motion_bounds":{"type":"array","description":"Observed discrete CNCData world positions projected into each operation WCS; not a continuous swept-envelope proof.","items":{"type":"object","required":["op","count","min_world","max_world","max_local_z_from_world_and_wcs","basis"],"properties":{"op":{"type":"integer"},"count":{"type":"integer","minimum":1},"min_world":{"$ref":"#/$defs/point"},"max_world":{"$ref":"#/$defs/point"},"max_local_z_from_world_and_wcs":{"type":"number"},"basis":{"type":"string"}}}},
    "summary":{"type":"object","required":["pass","fail","blocked","not_applicable","not_run"],"additionalProperties":{"type":"integer","minimum":0}},
    "validation_layers":{"type":"object","required":["configuration","cam_toolpath","posted_nc","machine_simulation","on_machine_record"],"additionalProperties":{"type":"object","required":["status"],"properties":{"status":{"$ref":"#/$defs/status"}}}},
    "operations":{"type":"array","minItems":1,"items":{"type":"object","required":["id","name","setup_id"]}},
    "parameters":{"type":"array","items":{"type":"object","required":["key","operation_id","setup_id","observed","evidence","proposed","applied","checks"],"properties":{"observed":{"type":"object","required":["value","unit","value_mode","frame_ref","reference_ref","enabled"],"properties":{"enabled":{"type":["boolean","null"]}}},"applied":{"type":"object","required":["state"],"properties":{"state":{"enum":["not_written","written","readback_verified","rolled_back"]}}},"evidence":{"type":"object","required":["state","sources"],"properties":{"state":{"enum":["observed","derived","missing","conflicted","outdated"]},"sources":{"type":"array","items":{"type":"string"}}}}}}},
    "checks":{"type":"array","minItems":1,"items":{"type":"object","required":["result_id","rule_id","operation_id","setup_id","status","criterion","observed_result","applicability_reason","evidence_refs","blocked_actions"],"properties":{"rule_id":{"type":"string","pattern":"^[MWSTHCGPDFOV][0-9]{2}$"},"status":{"$ref":"#/$defs/status"},"evidence_refs":{"type":"array","items":{"type":"string"}}}}}
  },
  "$defs":{"status":{"enum":["pass","fail","blocked","not_applicable","not_run"]},"point":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}}}
}
